#!/usr/bin/env python3
"""Stream Claude Code's live session registry (~/.claude/sessions) to Agent HUD.

Runs on every machine (the Mac app spawns one locally; remote boxes nohup it).
POSTs a snapshot to the HUD every few seconds — remotely that goes through the
SSH reverse tunnel (127.0.0.1:48085). Failures are silently retried.

The registry's `name` field falls back to an auto-generated "<user>-<xx>" when
a session is resumed, even if the user named it — the real name lives in the
transcript as `custom-title` records, so auto-looking names are resolved from
there (full scan once per session, then cheap tail scans to catch renames).

Start remotely with:
    nohup ~/agent-hud/bin/agent-hud-registry </dev/null >/dev/null 2>&1 &
Debug with:
    AGENT_HUD_ONESHOT=1 ~/agent-hud/bin/agent-hud-registry
"""
import base64
import calendar
import datetime
import getpass
import glob
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from hud_focus import recorded_focus, session_focus

URL = os.environ.get("AGENT_HUD_URL", "http://127.0.0.1:48085")
INTERVAL = float(os.environ.get("AGENT_HUD_REGISTRY_INTERVAL", "5"))
# The app spawns the local reporter with AGENT_HUD_HOST set: gethostname()
# flips with network state (corporate DNS names) and would split one machine
# into two hosts.
HOST = os.environ.get("AGENT_HUD_HOST") or socket.gethostname().split(".")[0]

try:
    _user = getpass.getuser()
except Exception:
    _user = os.environ.get("USER", "")
AUTO_NAME = re.compile("^" + re.escape(re.sub(r"[^a-zA-Z0-9]+", "-", _user)) + r"-[0-9a-f]{2}$")

_titles = {}  # sessionId -> [full_scan_done, title]


def transcript_for(sid):
    hits = glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % sid))
    return hits[0] if hits else None


def scan_title(path, tail_only):
    title = ""
    try:
        with open(path, "rb") as f:
            if tail_only:
                size = os.fstat(f.fileno()).st_size
                f.seek(max(0, size - 65536))
            for line in f:
                if b"custom-title" not in line:
                    continue
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                if j.get("type") == "custom-title" and j.get("customTitle"):
                    title = j["customTitle"]
    except Exception:
        pass
    return title


def display_name(sid, reg_name):
    if reg_name and not AUTO_NAME.match(reg_name):
        return reg_name
    path = transcript_for(sid)
    if path is None:
        return reg_name
    entry = _titles.get(sid)
    if entry is None:
        entry = _titles[sid] = [True, scan_title(path, tail_only=False)]
    else:
        t = scan_title(path, tail_only=True)
        if t:
            entry[1] = t
    return entry[1] or reg_name


_stats = {}  # sessionId -> [transcript_mtime, stats-dict]


def session_stats(sid):
    """Model + context/token stats from the transcript's last assistant usage record."""
    path = transcript_for(sid)
    if not path:
        return {}
    try:
        mtime = os.path.getmtime(path)
    except Exception:
        return {}
    cached = _stats.get(sid)
    if cached and cached[0] == mtime:
        return cached[1]
    st = {"model": "", "effort": "", "ctx_used": 0, "last_in": 0, "last_out": 0, "outcome": ""}
    try:
        with open(path, "rb") as f:
            size = os.fstat(f.fileno()).st_size
            f.seek(max(0, size - 262144))
            for line in f:
                # Truthful turn outcome: the LAST marker in the file wins.
                if b"[Request interrupted by user" in line:
                    st["outcome"] = "interrupted"
                    continue
                # Parse rather than byte-match the value: JSON spacing varies.
                if b"isApiErrorMessage" in line:
                    try:
                        if json.loads(line).get("isApiErrorMessage"):
                            st["outcome"] = "error"
                            continue
                    except Exception:
                        pass
                if b'"usage"' not in line:
                    continue
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                if j.get("type") != "assistant":
                    continue
                m = j.get("message") or {}
                u = m.get("usage") or {}
                if not u:
                    continue
                inp = u.get("input_tokens") or 0
                cc = u.get("cache_creation_input_tokens") or 0
                cr = u.get("cache_read_input_tokens") or 0
                out = u.get("output_tokens") or 0
                if inp + cc + cr == 0:
                    continue
                st["model"] = m.get("model") or st["model"]
                st["effort"] = j.get("effort") or st["effort"]
                st["ctx_used"] = inp + cc + cr + out
                st["last_in"] = inp + cc + cr
                st["last_out"] = out
                st["outcome"] = "finished"
    except Exception:
        pass
    _stats[sid] = [mtime, st]
    return st


def snapshot():
    d = os.path.expanduser("~/.claude/sessions")
    out = []
    cutoff = time.time() * 1000 - 24 * 3600 * 1000
    try:
        files = os.listdir(d)
    except Exception:
        return out
    for fn in files:
        if not fn.endswith(".json"):
            continue
        # The registry file is named <pid>.json; a killed terminal leaves it
        # behind still saying "busy", which reads as a live session forever.
        pid = fn[:-5]
        if pid.isdigit():
            try:
                os.kill(int(pid), 0)
            except ProcessLookupError:
                continue  # dead session, live-looking file
            except Exception:
                pass  # EPERM etc. = alive, just not ours
        try:
            with open(os.path.join(d, fn)) as f:
                j = json.load(f)
        except Exception:
            continue
        sid = j.get("sessionId")
        if not sid or (j.get("updatedAt") or 0) < cutoff:
            continue
        row = {
            "sessionId": sid,
            "name": display_name(sid, j.get("name") or ""),
            "cwd": j.get("cwd") or "",
            "status": j.get("status") or "",
            "app": "claude",
            "focus": session_focus("claude", sid, pid),
            "updatedAt": j.get("updatedAt") or 0,
        }
        row.update(session_stats(sid))
        row.update(file_changes(sid))
        out.append(row)
    # Evict caches for sessions this snapshot no longer reports (24h cutoff,
    # dead pid, deleted registry file): the daemon runs for weeks and would
    # otherwise keep an entry per sessionId forever. A wrongly-evicted live
    # session just costs one re-scan on its next appearance.
    live = {row["sessionId"] for row in out}
    for cache in (_titles, _stats, _changes):
        for sid in [s for s in cache if s not in live]:
            del cache[sid]
    return out


# --- what changed -------------------------------------------------------------
# The change receipt: files the session touched with approximate +/- line
# counts, aggregated from Edit/Write tool calls in the transcript. Incremental:
# each transcript is parsed once from the start, then only new bytes.

EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
_changes = {}  # sessionId -> {"offset", "files", "tokens", "turns"}


def _lines(s):
    return s.count("\n") + 1 if s else 0


def _count_tool_use(block, files):
    if block.get("type") != "tool_use" or block.get("name") not in EDIT_TOOLS:
        return
    inp = block.get("input") or {}
    path = inp.get("file_path") or inp.get("notebook_path") or ""
    if not path:
        return
    add = rm = 0
    name = block["name"]
    if name == "Write":
        add = _lines(inp.get("content") or "")
    elif name == "Edit":
        add = _lines(inp.get("new_string") or "")
        rm = _lines(inp.get("old_string") or "")
    elif name == "MultiEdit":
        for e in inp.get("edits") or []:
            add += _lines(e.get("new_string") or "")
            rm += _lines(e.get("old_string") or "")
    elif name == "NotebookEdit":
        add = _lines(inp.get("new_source") or "")
    entry = files.setdefault(path, [0, 0])
    entry[0] += add
    entry[1] += rm


def file_changes(sid):
    """Estimated editing activity, only after a successful matching tool result."""
    path = transcript_for(sid)
    if not path:
        return {}
    def empty():
        return {"offset": 0, "files": {}, "tokens": 0, "turns": 0,
                "pending": {}, "usage": {}}
    rec = _changes.setdefault(sid, empty())
    try:
        size = os.path.getsize(path)
        if size < rec["offset"]:
            rec = _changes[sid] = empty()
        if size > rec["offset"]:
            with open(path, "rb") as f:
                f.seek(rec["offset"])
                for line in f:
                    if not line.endswith(b"\n"):
                        break
                    rec["offset"] = f.tell()
                    try:
                        j = json.loads(line)
                    except ValueError:
                        continue
                    message = j.get("message") or {}
                    content = message.get("content") or []
                    if isinstance(content, str):
                        content = [{"type": "text", "text": content}]
                    if j.get("type") == "user":
                        if any(b.get("type") == "text" and b.get("text", "").strip()
                               and not b.get("text", "").startswith(("<", "[Request interrupted"))
                               for b in content if isinstance(b, dict)) and not j.get("isMeta"):
                            rec["turns"] += 1
                        for block in content:
                            if not isinstance(block, dict) or block.get("type") != "tool_result":
                                continue
                            attempted = rec["pending"].pop(block.get("tool_use_id"), None)
                            if attempted and not block.get("is_error"):
                                _count_tool_use(attempted, rec["files"])
                    elif j.get("type") == "assistant":
                        u = message.get("usage") or {}
                        if u:
                            tokens = sum(u.get(k) or 0 for k in
                                         ("input_tokens", "cache_creation_input_tokens", "output_tokens"))
                            mid = message.get("id") or j.get("uuid") or str(rec["offset"])
                            previous = rec["usage"].get(mid, 0)
                            rec["tokens"] += max(0, tokens - previous)
                            rec["usage"][mid] = max(tokens, previous)
                        for block in content:
                            if isinstance(block, dict) and block.get("type") == "tool_use" and block.get("id"):
                                if block.get("name") in EDIT_TOOLS:
                                    rec["pending"][block["id"]] = block
                        # Bound retained request bodies and streamed-message IDs.
                        for key in ("pending", "usage"):
                            while len(rec[key]) > 512:
                                rec[key].pop(next(iter(rec[key])))
    except (OSError, TypeError):
        return {}
    files = rec["files"]
    out = {"total_tokens": rec["tokens"], "turns": rec["turns"]}
    if files:
        top = max(files.items(), key=lambda kv: kv[1][0] + kv[1][1])
        out.update({"files_changed": len(files), "lines_added": sum(v[0] for v in files.values()),
                    "lines_removed": sum(v[1] for v in files.values()), "top_file": os.path.basename(top[0])})
    return out


# --- Codex sessions -----------------------------------------------------------
# Codex keeps one rollout JSONL per session under ~/.codex/sessions/YYYY/MM/DD.
# Lifecycle comes from explicit rollout events. A quiet file is not a successful
# completion; hooks supply approval/interruption events when enabled.

CODEX_SESSIONS = os.path.expanduser("~/.codex/sessions")
CODEX_BUSY_SECONDS = 90  # legacy constant; never used to infer completion
_codex_state = {}
_codex_meta = {}   # path -> (session_id, cwd, model)
_codex_rate = (None, 0.0)   # (rate_limits dict, epoch of the record it came from)


def _codex_title(text):
    """A card-sized title from the first thing the user actually typed.

    Codex opens every session with injected blocks — <environment_context>,
    <recommended_plugins>, <user_instructions> — and cmux pastes images in as
    their own record. All of them are markup from the first character, which
    a typed prompt almost never is, so that alone tells them apart."""
    text = (text or "").strip()
    if not text or text.startswith("<"):
        return ""
    line = next((" ".join(l.split()) for l in text.splitlines() if l.strip()), "")
    if len(line) > 44:
        line = line[:44].rsplit(" ", 1)[0] or line[:44]
    return line


def _codex_head(path):
    """session_meta is always the first record, and the first user message is
    a few records later. Codex sessions have no name of their own — without a
    title every session started from $HOME shows up as your username."""
    if path in _codex_meta:
        return _codex_meta[path]
    sid = cwd = model = title = ""
    size = 0
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            for n, line in enumerate(f):
                if n > 400 or f.tell() > 524288:
                    break
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                pl = j.get("payload") or {}
                if j.get("type") == "session_meta":
                    sid = pl.get("session_id") or pl.get("id") or ""
                    cwd = pl.get("cwd") or ""
                    model = pl.get("model") or pl.get("model_provider") or ""
                elif not title and pl.get("role") == "user":
                    for c in pl.get("content") or []:
                        title = _codex_title(c.get("text"))
                        if title:
                            break
                if sid and title:
                    break
    except Exception:
        pass
    # A session whose first prompt hasn't landed yet is re-read next tick —
    # the file is still tiny then. Past that, take what we have.
    if title or size > 1048576:
        _codex_meta[path] = (sid, cwd, model, title)
    return (sid, cwd, model, title)


def _codex_ts(rec):
    """Epoch seconds for a rollout record's ISO-8601 `timestamp`."""
    t = (rec.get("timestamp") or "").replace("Z", "+00:00")
    try:
        return datetime.datetime.fromisoformat(t).timestamp()
    except Exception:
        return 0.0


def _codex_read(path):
    """Incremental lifecycle/usage scan. Preserve the last complete JSON line."""
    stat = os.stat(path)
    rec = _codex_state.get(path)
    if not rec or rec["inode"] != stat.st_ino or stat.st_size < rec["offset"]:
        rec = _codex_state[path] = {"inode": stat.st_ino, "offset": 0, "mtime": 0,
            "model": "", "total_tokens": 0, "rate": None, "rate_ts": 0.0,
            "status": "unknown", "outcome": "unknown", "turns": 0,
            "ctx_used": 0, "ctx_limit": 0, "last_in": 0, "last_out": 0, "effort": ""}
    if rec["offset"] == stat.st_size and rec["mtime"] == stat.st_mtime_ns:
        return rec
    with open(path, "rb") as f:
        f.seek(rec["offset"])
        for line in f:
            if not line.endswith(b"\n"):
                break
            rec["offset"] = f.tell()
            try:
                j = json.loads(line)
            except ValueError:
                continue
            pl = j.get("payload") or {}
            if not isinstance(pl, dict):
                continue
            typ = pl.get("type")
            if j.get("type") == "session_meta":
                rec["ctx_limit"] = pl.get("context_window") or rec["ctx_limit"]
                source = pl.get("source") or pl.get("thread_source") or ""
                rec["internal"] = (isinstance(source, dict) and "subagent" in source) or \
                    any(x in str(pl.get("originator", "")).lower() for x in ("title_generator", "title-generation"))
            if j.get("type") == "turn_context":
                rec["model"] = pl.get("model") or rec["model"]
                rec["effort"] = pl.get("effort") or rec["effort"]
            elif j.get("type") == "event_msg":
                if typ in ("task_started", "turn_started"):
                    rec["status"], rec["outcome"] = "busy", ""
                    rec["turns"] += 1
                    rec["ctx_limit"] = pl.get("model_context_window") or rec["ctx_limit"]
                elif typ in ("task_complete", "turn_complete", "turn_completed"):
                    rec["status"], rec["outcome"] = "idle", "finished"
                elif typ in ("turn_aborted", "task_aborted"):
                    rec["status"], rec["outcome"] = "idle", "interrupted"
                elif typ in ("error", "turn_failed"):
                    rec["status"], rec["outcome"] = "idle", "error"
                elif typ == "token_count":
                    rate = pl.get("rate_limits")
                    if isinstance(rate, dict):
                        rec["rate"], rec["rate_ts"] = rate, _codex_ts(j)
                    info = pl.get("info") or {}
                    rec["ctx_limit"] = info.get("model_context_window") or rec["ctx_limit"]
                    u = info.get("total_token_usage") or {}
                    rec["total_tokens"] = max(rec["total_tokens"], u.get("total_tokens") or 0)
                    last = info.get("last_token_usage") or {}
                    rec["ctx_used"] = last.get("total_tokens") or rec["ctx_used"]
                    rec["last_in"] = last.get("input_tokens") or rec["last_in"]
                    rec["last_out"] = last.get("output_tokens") or rec["last_out"]
            elif j.get("type") == "token_usage_record":
                for key in ("thread_token_usage", "total_token_usage", "usage"):
                    u = pl.get(key)
                    if isinstance(u, dict) and isinstance(u.get("total_tokens"), int):
                        rec["total_tokens"] = max(rec["total_tokens"], u["total_tokens"])
                        break
    rec["mtime"] = stat.st_mtime_ns
    return rec


def _codex_tail(path):
    # Compatibility with callers of the original narrow statistics helper.
    rec = _codex_read(path)
    return rec["model"], rec["total_tokens"], rec["rate"], rec["rate_ts"]


def codex_snapshot():
    global _codex_rate
    out = []
    _codex_rate = (None, 0.0)
    now = time.time()
    paths = glob.glob(os.path.join(CODEX_SESSIONS, "*", "*", "*", "rollout-*.jsonl"))
    live = set()
    for path in paths:
        try:
            mtime = os.path.getmtime(path)
            if now - mtime > 24 * 3600:
                continue
            live.add(path)
            sid, cwd, meta_model, title = _codex_head(path)
            if not sid:
                continue
            rec = _codex_read(path)
        except (OSError, ValueError, TypeError):
            continue
        if rec.get("internal"):
            continue
        if rec["rate"] and rec["rate_ts"] > _codex_rate[1]:
            _codex_rate = (rec["rate"], rec["rate_ts"])
        row = {"sessionId": sid, "name": title or os.path.basename(cwd.rstrip("/")) or "codex",
               "cwd": cwd, "updatedAt": int(mtime * 1000), "app": "codex"}
        row["focus"] = recorded_focus("codex", sid)
        for key in ("status", "outcome", "model", "effort", "ctx_used", "ctx_limit",
                    "last_in", "last_out", "total_tokens", "turns"):
            row[key] = rec[key]
        row["model"] = row["model"] or meta_model
        # An abandoned process may never write an ending. After an hour with
        # no evidence of activity, report uncertainty, never a successful end.
        if row["status"] == "busy" and now - mtime > 3600:
            row["status"], row["outcome"] = "unknown", "unknown"
        out.append(row)
    for cache in (_codex_meta, _codex_state):
        for path in list(cache):
            if path not in live:
                del cache[path]
    return out


# --- account-usage estimation (ccusage-style) ---------------------------------
# Incrementally tails every transcript, bucketing costly tokens (input +
# cache-creation + output; cache reads excluded) per hour. Reported as rolling
# 5h/7d sums plus the busiest 5h window of the week for self-calibrated bars.

_usage_files = {}    # path -> [resume_offset, {epoch-hour: tokens}] (that file's share)
_usage_buckets = {}  # epoch-hour -> tokens
_usage_last = 0.0


def _bucket_add(ts, tokens, contrib):
    try:
        eh = calendar.timegm((int(ts[0:4]), int(ts[5:7]), int(ts[8:10]),
                              int(ts[11:13]), 0, 0)) // 3600
    except Exception:
        return
    _usage_buckets[eh] = _usage_buckets.get(eh, 0) + tokens
    contrib[eh] = contrib.get(eh, 0) + tokens


def _tail_parse(f, contrib):
    offset = f.tell()
    while True:
        line = f.readline()
        if not line:
            break
        if not line.endswith(b"\n"):
            break  # partially written line; resume here next round
        offset = f.tell()
        if b'"usage"' not in line or b'"assistant"' not in line:
            continue
        try:
            j = json.loads(line)
        except Exception:
            continue
        if j.get("type") != "assistant":
            continue
        u = (j.get("message") or {}).get("usage") or {}
        tokens = (u.get("input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0) \
            + (u.get("output_tokens") or 0)
        if tokens:
            _bucket_add(j.get("timestamp") or "", tokens, contrib)
    return offset


def usage_windows():
    global _usage_last
    now = time.time()
    if now - _usage_last >= 60 or not _usage_buckets:
        _usage_last = now
        cutoff = now - 8 * 86400
        seen = set()
        for path in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
            try:
                stt = os.stat(path)
            except Exception:
                continue
            if stt.st_mtime < cutoff:
                continue
            seen.add(path)
            rec = _usage_files.get(path)
            if rec and stt.st_size < rec[0]:
                # rotated/truncated: forget this file's share of the buckets
                # before re-parsing from 0, or its tokens are counted twice
                # (file_changes handles the same case for its counters).
                for k, v in rec[1].items():
                    left = _usage_buckets.get(k, 0) - v
                    if left > 0:
                        _usage_buckets[k] = left
                    else:
                        _usage_buckets.pop(k, None)
                rec = _usage_files[path] = [0, {}]
            start = rec[0] if rec else 0
            if start == stt.st_size:
                continue
            contrib = rec[1] if rec else {}
            try:
                with open(path, "rb") as f:
                    f.seek(start)
                    _usage_files[path] = [_tail_parse(f, contrib), contrib]
            except Exception:
                continue
        floor = int(now // 3600) - 8 * 24
        for k in [k for k in _usage_buckets if k < floor]:
            del _usage_buckets[k]
        for rec in _usage_files.values():
            for k in [k for k in rec[1] if k < floor]:
                del rec[1][k]
        # Drop tails for transcripts the 8-day window no longer covers: the
        # daemon runs for weeks and would otherwise keep an entry for every
        # transcript it has ever seen. Evict only on positive evidence the
        # file aged out. A stat that RAISES (unreadable home, network-home
        # hiccup, file deleted mid-pass) proves nothing: that file's tokens
        # are still live in the shared buckets, and forgetting its offset
        # makes the next sighting re-parse the whole transcript and add all
        # of them a second time, with nothing to subtract the orphan —
        # inflating 5h/7d/peak for the rest of the 8-day window. A kept entry
        # costs a few bytes; a dropped one costs eight days of wrong numbers.
        for p in [p for p in _usage_files if p not in seen]:
            try:
                aged = os.stat(p).st_mtime < cutoff
            except Exception:
                aged = False  # missed this pass; keep the tail
            # An empty share means every hour this file fed the buckets has
            # already been pruned above, so re-parsing it can't double-count.
            if aged or not _usage_files[p][1]:
                del _usage_files[p]
    nh = int(now // 3600)
    h5 = sum(v for k, v in _usage_buckets.items() if k > nh - 5)
    d7 = sum(v for k, v in _usage_buckets.items() if k > nh - 168)
    peak = 0
    for s in range(nh - 168, nh + 1):
        w = sum(_usage_buckets.get(k, 0) for k in range(s, s + 5))
        if w > peak:
            peak = w
    hours = {str(k): v for k, v in _usage_buckets.items() if k > nh - 48}
    return {"h5": h5, "d7": d7, "h5_peak": peak, "hours": hours}


# --- real account limits ------------------------------------------------------
# Anthropic reports true rate-limit utilization (including per-model weekly
# limits like Fable) at /api/oauth/usage — the same endpoint Claude Code's
# /status and ccstatusline read. Source preference:
#   1. ccstatusline's cache, if fresh — costs nothing and touches no secrets
#      (but it only carries session/weekly, no per-model scope)
#   2. a direct call with the local OAuth token, cached for USAGE_TTL — the
#      only source for the per-model (Fable) limit
#   3. Claude Code's own ~/.claude.json cache, however old it is
# Every step degrades silently; the HUD falls back to token estimates.

USAGE_CACHE = os.path.expanduser("~/.cache/agent-hud/usage.json")
USAGE_TTL = 180
CCSTATUSLINE_CACHE = os.path.expanduser("~/.cache/ccstatusline/usage.json")
PLAN_NAMES = [
    ("max_20x", "Max 20x"), ("max_5x", "Max 5x"), ("max", "Max"),
    ("team", "Team"), ("enterprise", "Enterprise"), ("pro", "Pro"),
]


def account_info():
    try:
        with open(os.path.expanduser("~/.claude.json")) as f:
            oa = json.load(f).get("oauthAccount") or {}
    except Exception:
        return {}
    tier = (oa.get("organizationRateLimitTier") or "").lower()
    plan = next((name for key, name in PLAN_NAMES if key in tier), "")
    email = oa.get("emailAddress") or ""
    return {
        # uuid identifies the account even if the display name is duplicated;
        # each machine reports whichever account IT is logged into.
        "uuid": oa.get("accountUuid") or email,
        "name": oa.get("displayName") or email,
        "email": email,
        "plan": plan,
    }


def _oauth_token():
    """The local Claude Code OAuth token: macOS Keychain, else creds file."""
    try:
        r = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
            capture_output=True, text=True, timeout=6)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout.strip())["claudeAiOauth"]["accessToken"]
    except Exception:
        pass
    try:
        with open(os.path.expanduser("~/.claude/.credentials.json")) as f:
            return json.load(f)["claudeAiOauth"]["accessToken"]
    except Exception:
        return None


def _item(kind, label, percent, severity, resets_at):
    return {"kind": kind, "label": label, "percent": round(float(percent), 1),
            "severity": severity or "normal", "resets_at": resets_at or ""}


def _from_api(u):
    items = []
    for lim in u.get("limits") or []:
        kind = lim.get("kind") or ""
        label = {"session": "5h", "weekly_all": "Week"}.get(kind, "")
        if kind == "weekly_scoped":
            label = (((lim.get("scope") or {}).get("model") or {}).get("display_name") or "Model")
        if not label:
            continue
        items.append(_item(kind, label, lim.get("percent") or 0,
                           lim.get("severity"), lim.get("resets_at")))
    if not items:
        for key, label in (("five_hour", "5h"), ("seven_day", "Week")):
            w = u.get(key)
            if isinstance(w, dict) and w.get("utilization") is not None:
                items.append(_item(key, label, w["utilization"], "normal", w.get("resets_at")))
    return items


def _from_ccstatusline(d):
    items = []
    for key, reset_key, label in (("sessionUsage", "sessionResetAt", "5h"),
                                  ("weeklyUsage", "weeklyResetAt", "Week"),
                                  ("weeklyOpusUsage", "weeklyOpusResetAt", "Opus"),
                                  ("weeklySonnetUsage", "weeklySonnetResetAt", "Sonnet")):
        v = d.get(key)
        if v:  # skip absent and 0 model-scoped entries
            items.append(_item(key, label, v, "normal", d.get(reset_key)))
    return items


def _fetch_limits_uncached():
    tok = _oauth_token()
    if tok:
        try:
            req = urllib.request.Request(
                "https://api.anthropic.com/api/oauth/usage",
                headers={"Authorization": "Bearer " + tok,
                         "anthropic-beta": "oauth-2025-04-20"})
            u = json.loads(urllib.request.urlopen(req, timeout=8).read())
            items = _from_api(u)
            if items:
                return {"source": "api", "items": items}
        except Exception:
            pass
    try:
        st = os.stat(CCSTATUSLINE_CACHE)
        if time.time() - st.st_mtime < 900:
            with open(CCSTATUSLINE_CACHE) as f:
                items = _from_ccstatusline(json.load(f))
            if items:
                return {"source": "ccstatusline", "items": items}
    except Exception:
        pass
    try:
        with open(os.path.expanduser("~/.claude.json")) as f:
            cached = json.load(f).get("cachedUsageUtilization") or {}
        items = _from_api(cached.get("utilization") or {})
        if items:
            return {"source": "claude.json", "items": items,
                    "fetched_at": (cached.get("fetchedAtMs") or 0) / 1000.0}
    except Exception:
        pass
    return None


def limits():
    # `make test` and oneshot debugging must not read the real keychain or
    # hit the live API — AGENT_HUD_SKIP_LIMITS short-circuits the whole path.
    if os.environ.get("AGENT_HUD_SKIP_LIMITS"):
        return None
    acct = account_info()
    try:
        st = os.stat(USAGE_CACHE)
        if time.time() - st.st_mtime < USAGE_TTL:
            with open(USAGE_CACHE) as f:
                cached = json.load(f)
            # A cached reading belongs to the account it was fetched for —
            # after a /logout + /login it must not be shown for the new one.
            if (cached.get("account") or {}).get("uuid") == acct.get("uuid"):
                return None if cached.get("failed") else cached
    except Exception:
        pass
    data = _fetch_limits_uncached()
    if not data:
        # Negative-cache the failure too: on a box that can't reach the API,
        # every INTERVAL would otherwise re-run the keychain subprocess plus
        # an HTTPS attempt. Retry on the USAGE_TTL cadence instead.
        data = {"failed": True}
    data.setdefault("fetched_at", time.time())
    data["account"] = acct
    try:
        os.makedirs(os.path.dirname(USAGE_CACHE), exist_ok=True)
        with open(USAGE_CACHE, "w") as f:
            json.dump(data, f)
    except Exception:
        pass
    return None if data.get("failed") else data



# --- Codex limits -------------------------------------------------------------
# Codex has no usage endpoint we can call, but it doesn't need one: every
# `token_count` event in the rollout carries the server's own `rate_limits`
# block — the same numbers `codex /status` prints. codex_snapshot() picks the
# freshest one off the tail scan it already does, so this costs no extra I/O.

CODEX_AUTH = os.path.expanduser("~/.codex/auth.json")
# A reading is only as fresh as the last turn, so unlike the Claude card (which
# re-fetches from the API) this one is allowed to sit on the HUD for the whole
# day the rollout scan covers. It marks itself stale after 30 minutes.
CODEX_RETENTION = 24 * 3600


def _codex_account():
    """Who Codex is logged in as. The id_token is read locally for its email
    claim only — never sent anywhere."""
    acct = {"uuid": "codex", "name": "", "plan": ""}
    try:
        with open(CODEX_AUTH) as f:
            auth = json.load(f)
    except Exception:
        return acct
    tokens = auth.get("tokens") or {}
    if tokens.get("account_id"):
        acct["uuid"] = "codex:" + tokens["account_id"]
    try:
        claims = (tokens.get("id_token") or "").split(".")[1]
        claims += "=" * (-len(claims) % 4)
        c = json.loads(base64.urlsafe_b64decode(claims))
        acct["name"] = c.get("email") or c.get("name") or ""
    except Exception:
        pass
    return acct


def _codex_window_label(minutes):
    if not isinstance(minutes, int) or minutes <= 0:
        return "limit"
    if minutes == 300:
        return "5h"
    if minutes == 10080:
        return "Week"
    if minutes < 1440:
        return "%dh" % (minutes // 60)
    return "%dd" % (minutes // 1440)


def _codex_plan(rate):
    """`self_serve_business_prolite` is the limiter's own tier name; show it
    the way a human would write it."""
    plan = (rate.get("plan_type") or "").replace("self_serve_", "")
    return " ".join(w.capitalize() for w in plan.split("_") if w)


def codex_limits():
    if os.environ.get("AGENT_HUD_SKIP_LIMITS"):
        return None
    rate, ts = _codex_rate
    if not rate or not ts:
        return None
    items = []
    for key, kind in (("primary", "primary"), ("secondary", "secondary"),
                      ("individual_limit", "individual")):
        w = rate.get(key)
        if not isinstance(w, dict) or w.get("used_percent") is None:
            continue
        resets = ""
        if isinstance(w.get("resets_at"), (int, float)):
            resets = datetime.datetime.fromtimestamp(
                w["resets_at"], datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        pct = float(w["used_percent"])
        severity = "critical" if pct >= 95 else ("warning" if pct >= 75 else "normal")
        items.append(_item(kind, _codex_window_label(w.get("window_minutes")),
                           pct, severity, resets))
    if not items:
        return None
    # Rollout usage has no authenticated account identity. Never relabel an old
    # reading with whoever happens to be in auth.json after an account switch.
    account_id = rate.get("account_id")
    acct = {"uuid": "codex:" + str(account_id) if account_id else "codex:unattributed:" + HOST,
            "name": "Codex" if account_id else "Codex · account unverified", "plan": _codex_plan(rate)}
    return {"source": "codex-rollout", "provider": "openai", "fetched_at": ts,
            "retention_seconds": CODEX_RETENTION, "account": acct, "items": items}


def payload():
    # Sessions first: the Codex scan is what picks up its rate-limit reading.
    codex = codex_snapshot()
    body = {"host": HOST, "sessions": snapshot() + codex, "usage": usage_windows(),
            "providers": ["claude", "codex"], "protocol": 2, "reporter_version": "0.3.1"}
    lim = limits()
    if lim:
        body["limits"] = lim
    extra = [x for x in (codex_limits(),) if x]
    if extra:
        body["limits_extra"] = extra
    return body


# The HUD drops a host it hasn't heard from in 90s, so a quiet machine still
# has to say something — but every few seconds, forever, is what made the app
# grow by hundreds of MB a day: each POST is a fresh connection plus a full
# pass through the app's state and every mounted view. An unchanged snapshot
# tells the HUD nothing it doesn't already have, so send it on a slow clock.
HEARTBEAT = float(os.environ.get("AGENT_HUD_HEARTBEAT", "30"))


def should_send(body, last_body, last_sent, now):
    """Send when something changed, or when the HUD needs proof we're alive."""
    return body != last_body or now - last_sent >= HEARTBEAT


def main():
    if os.environ.get("AGENT_HUD_ONESHOT"):
        print(json.dumps(payload(), indent=1))
        return
    last_body, last_sent = None, 0.0
    while True:
        body = json.dumps(payload()).encode()
        now = time.time()
        if should_send(body, last_body, last_sent, now):
            try:
                req = urllib.request.Request(
                    URL + "/sessions", data=body,
                    headers={"Content-Type": "application/json"},
                )
                urllib.request.urlopen(req, timeout=3).read()
                last_body, last_sent = body, now
            except Exception:
                pass  # retry next tick; don't record it as sent
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
