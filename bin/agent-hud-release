#!/bin/bash
# Reproducible local artifacts. Publishing is a separate, explicit gh command.
set -euo pipefail
cd "$(dirname "$0")/.."
VERSION="${1:?Usage: bin/agent-hud-release vX.Y.Z}"
[[ "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Expected a version tag'; exit 1; }
make test
swift build --package-path app -c release --arch arm64 --arch x86_64 -Xswiftc -warnings-as-errors
# SwiftPM's output path differs between toolchains; ask it, do not assume it.
BIN_PATH="$(swift build --package-path app -c release --arch arm64 --arch x86_64 --show-bin-path)"
make bundle VERSION="$VERSION" BIN="$BIN_PATH/AgentHUD" SWIFT_FLAGS="--arch arm64 --arch x86_64 -Xswiftc -warnings-as-errors"
python3 - <<'PY'
import subprocess
architectures = subprocess.check_output(['/usr/bin/lipo', '-archs', 'dist/AgentHUD.app/Contents/MacOS/AgentHUD'], text=True).split()
if set(architectures) != {'arm64', 'x86_64'}:
    raise SystemExit('Expected a universal Mac binary; got ' + repr(architectures))
PY
xcodebuild -project 'safari/Agent HUD Bridge/Agent HUD Bridge.xcodeproj' -scheme 'Agent HUD Bridge' -configuration Release -derivedDataPath safari/build CODE_SIGNING_ALLOWED=NO build
SAFARI='safari/build/Build/Products/Release/Agent HUD Bridge.app'
codesign --force --sign - "$SAFARI/Contents/PlugIns/Agent HUD Bridge Extension.appex"
codesign --force --sign - "$SAFARI"
make watch
mkdir -p dist/release
# ditto preserves app symlinks, modes and signatures. Never include host config.
rm -f dist/release/AgentHUD.app.zip dist/release/AgentHUD-Safari-Bridge.app.zip \
  dist/release/agent-hud-chrome-extension.zip dist/release/AgentHUDWatch-Simulator.app.zip
ditto -c -k --sequesterRsrc --keepParent dist/AgentHUD.app dist/release/AgentHUD.app.zip
ditto -c -k --sequesterRsrc --keepParent "$SAFARI" dist/release/AgentHUD-Safari-Bridge.app.zip
(cd extension && zip -q -r ../dist/release/agent-hud-chrome-extension.zip . -x '*.DS_Store')
ditto -c -k --sequesterRsrc --keepParent watch/build/Build/Products/Release-watchsimulator/AgentHUDWatch.app dist/release/AgentHUDWatch-Simulator.app.zip
(cd dist/release && shasum -a 256 ./*.zip > SHA256SUMS.txt)
codesign --verify --deep --strict dist/AgentHUD.app
codesign --verify --deep --strict "$SAFARI"
echo "Prepared $VERSION in dist/release (ad-hoc signed; not notarized)."
