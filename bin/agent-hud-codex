#!/usr/bin/env python3
"""Observe Codex notify (argv) and lifecycle hooks (stdin); never decide approvals.

The previous notify command is chained only for notify invocations. Optional
hooks provide running/attention/interrupted states and require Codex hook trust.
"""
import json
import os
import socket
import subprocess
import sys
import urllib.request

URL = os.environ.get("AGENT_HUD_URL", "http://127.0.0.1:48085")
HOST = os.environ.get("AGENT_HUD_HOST") or socket.gethostname().split(".")[0]
# Written by the installer: the notify program we displaced, argv and all.
CHAIN = os.path.join(os.environ.get("AGENT_HUD_CODEX_DIR", os.path.expanduser("~/.codex")),
                     "agent-hud-chain.json")


def post(body):
    try:
        req = urllib.request.Request(
            URL + "/event", data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=2.5).read()
    except Exception:
        pass  # the HUD being down is never Codex's problem


def payload(argv):
    """Codex appends a JSON blob as the last argument; earlier ones are the
    fixed args from the config array. Take the last thing that parses."""
    for arg in reversed(argv):
        try:
            d = json.loads(arg)
            if isinstance(d, dict):
                return d
        except Exception:
            continue
    return {}


def handoff(argv):
    """Run whatever `notify` pointed at before we took the slot."""
    try:
        with open(CHAIN) as f:
            original = json.load(f)
    except Exception:
        return
    if not isinstance(original, list) or not original or not all(isinstance(x, str) for x in original):
        return
    try:
        subprocess.run(list(original) + argv, timeout=20, check=False)
    except Exception:
        pass


def main():
    argv = sys.argv[1:]
    d = payload(argv)
    is_notify = bool(d)
    if not is_notify and not sys.stdin.isatty():
        try:
            d = json.loads(sys.stdin.read(1_048_576))
        except (ValueError, OSError):
            d = {}
    if not isinstance(d, dict):
        d = {}
    hook = d.get("hook_event_name") or ""
    event = {"SessionStart": "info", "UserPromptSubmit": "running",
             "PermissionRequest": "attention", "Stop": "done",
             "Interrupt": "done", "SessionEnd": "done"}.get(hook)
    outcome = {"Stop": "finished", "Interrupt": "interrupted", "SessionEnd": "unknown"}.get(hook, "")
    if is_notify and d.get("type") in ("agent-turn-complete", "turn-ended", "agent-turn-completed"):
        event, outcome = "done", "finished"
    sid = d.get("thread-id") or d.get("thread_id") or d.get("session_id")
    # Turn IDs and folder names are not conversation IDs. Internal helper
    # notifications without a thread must not create phantom session cards.
    if event and isinstance(sid, str) and sid:
        msg = str(d.get("last-assistant-message") or d.get("last_assistant_message")
                  or d.get("prompt") or "").strip()
        # Codex's title helper can publish a one-field structured response.
        # Suppress that exact internal shape, not arbitrary JSON answers.
        try:
            title_response = json.loads(msg)
        except (ValueError, TypeError):
            title_response = None
        if isinstance(title_response, dict) and set(title_response) == {"title"}:
            event = None
        cwd = d.get("cwd") or os.getcwd()
        project = os.path.basename(cwd.rstrip("/")) or "codex"
        body = {
            "event": event,
            "host": HOST,
            "app": "codex",
            "project": project,
            "cwd": cwd,
            "session_id": sid,
            "session_name": "",  # the registry's prompt-derived title wins
            "message": msg[:300] or {"attention": "permission requested", "running": "working",
                                      "info": "session opened"}.get(event, outcome or "session ended"),
            "outcome": outcome,
            "model": d.get("model") or "",
            "hook": hook or "notify",
            "focus": {"workspace": os.environ.get("CMUX_WORKSPACE_ID", ""),
                      "surface": os.environ.get("CMUX_SURFACE_ID", "")},
        }
        if event:
            post(body)
    if is_notify:
        handoff(argv)
    else:
        print("{}")


if __name__ == "__main__":
    main()
