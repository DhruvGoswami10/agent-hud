#!/usr/bin/env python3
"""Fill a playground HUD with synthetic sessions, so the screenshots in the
README can be staged without putting anyone's real work on the internet.

    make demo          # launches the playground and seeds it

Everything here is invented: the hosts, the session names, the accounts and
the numbers. Nothing touches the live HUD on :48085.
"""
import json
import os
import sys
import time
import urllib.request

PORT = int(os.environ.get("AGENT_HUD_PORT", "48086"))


def post(path, obj):
    req = urllib.request.Request(
        "http://127.0.0.1:%d%s" % (PORT, path), data=json.dumps(obj).encode(),
        headers={"Content-Type": "application/json"})
    return urllib.request.urlopen(req, timeout=10).read()


def session(sid, name, cwd, ctx, **extra):
    d = {"sessionId": sid, "name": name, "cwd": cwd, "status": "busy",
         "updatedAt": int(time.time() * 1000), "model": "claude-opus-5",
         "effort": "high", "ctx_used": ctx, "ctx_limit": 200000, "last_in": ctx - 2000, "last_out": 1800}
    d.update(extra)
    return d


def account(uuid, plan, items, **extra):
    d = {"source": "api", "fetched_at": time.time(),
         "account": {"uuid": uuid, "name": "you@example.com", "plan": plan},
         "items": [{"kind": k, "label": l, "percent": p, "severity": s, "resets_at": r}
                   for (k, l, p, s, r) in items]}
    d.update(extra)
    return d


def main():
    soon = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + 3 * 3600))
    week = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + 40 * 3600))
    hour = int(time.time()) // 3600

    post("/sessions", {
        "host": "mac",
        "sessions": [
            session("s1", "agent-hud", "/Users/you/code/agent-hud", 148000,
                    files_changed=12, lines_added=486, lines_removed=93,
                    top_file="NotchView.swift"),
            session("s2", "docs-site", "/Users/you/code/docs-site", 41000),
        ],
        "usage": {"h5": 820000, "d7": 5400000, "h5_peak": 1100000,
                  "hours": {str(hour - i): max(0, 240000 - i * 8000) for i in range(30)}},
        "limits": account("acct-1", "Max 20x",
                          [("session", "5h", 34, "normal", soon),
                           ("weekly_all", "Week", 61, "normal", week),
                           ("weekly_scoped", "Opus", 88, "warning", week)]),
    })
    post("/sessions", {
        "host": "build-box",
        "sessions": [
            session("s3", "api-refactor", "/home/you/api", 96000,
                    files_changed=31, lines_added=1204, lines_removed=618,
                    top_file="handlers.rs"),
        ],
        "usage": {"h5": 190000, "d7": 900000, "h5_peak": 300000, "hours": {}},
        # A second provider shares the same bounded, scrollable panel.
        "limits_extra": [account("codex-acct", "Business",
                                 [("primary", "Week", 18, "normal", week)],
                                 provider="openai", source="codex-rollout")],
    })
    print("seeded the playground on :%d" % PORT, file=sys.stderr)


if __name__ == "__main__":
    main()
