#!/bin/bash
# Cleanly remove Agent HUD from this Mac: the app, its LaunchAgents, the
# provider hooks it added, and its caches. Leaves the repo itself, your
# ~/.claude sessions/transcripts, and all backups untouched.
#
# Usage: bin/agent-hud-uninstall
set -u

echo "Agent HUD uninstall"

# Unregister the same login service the app actually uses, before quitting.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for app in "$SCRIPT_DIR/../dist/AgentHUD.app" "$SCRIPT_DIR/../../.." "/Applications/AgentHUD.app"; do
    if [ -x "$app/Contents/MacOS/AgentHUD" ]; then
        "$app/Contents/MacOS/AgentHUD" --unregister-login-item
        break
    fi
done

# 1. Stop the app (this also takes the local registry reporter down with it).
if pgrep -x AgentHUD >/dev/null 2>&1; then
    killall AgentHUD 2>/dev/null && echo "· stopped AgentHUD.app"
fi
pkill -f "[a]gent-hud-registry" 2>/dev/null && echo "· stopped local registry reporter"
pkill -f "[a]gent-hud-watch-bridge" 2>/dev/null
pkill -f "([a]gent-hud-tunnels|[h]ud_tunnels.py)" 2>/dev/null && echo "· stopped tunnel keeper"
# Tunnels orphaned by a crashed keeper live in their own process group and
# survive the line above — match the tunnel command itself. Requiring -N and
# the exact forward spec keeps this away from unrelated ssh sessions.
pkill -f "ssh.*-N -R 48085:127.0.0.1:48085" 2>/dev/null && echo "· killed orphaned tunnels"

# 2. LaunchAgents (login item + tunnel keeper).
for label in dev.dhruv.agenthud.app dev.dhruv.agenthud.tunnels; do
    plist="$HOME/Library/LaunchAgents/$label.plist"
    if [ -f "$plist" ]; then
        launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
        rm -f "$plist"
        echo "· removed LaunchAgent $label"
    fi
done

# Restore only our Claude/Cursor/Codex integrations, preserving other hooks.
python3 "$SCRIPT_DIR/install-hooks.py" --uninstall || exit 1

# 4. Caches.
rm -rf "$HOME/.cache/agent-hud" && echo "· removed ~/.cache/agent-hud"
rm -rf "$HOME/Library/Application Support/AgentHUD/session-focus" && echo "· removed saved session locations"

cat <<'EOF'

Done on this Mac. Also, if you set them up:
· Remote boxes: on each box run
      pkill -f '[a]gent-hud-registry'
  and re-run this script there to drop the hooks
  (python3 bin/install-hooks.py --uninstall removes the integrations remotely).
· Browser extensions: remove "Agent HUD Bridge" from
  chrome://extensions / Safari Settings → Extensions.
· The repo itself and any dist/ builds are untouched — delete the
  folder when you're ready.
EOF
